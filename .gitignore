# ============================================================
# Encore iOS — .gitignore
# ============================================================

# ── Supabase secrets (NEVER commit) ─────────────────────────
Encore/SupabaseConfig.swift
Encore/Secrets.xcconfig

# ── Apple Certificates, Keys & Provisioning (NEVER commit) ──
*.p12
*.p8
*.pem
*.cer
*.mobileprovision
*.provisionprofile
*.keystore
pass_cert.pem
pass_key.pem
pass_signer.pem

# ── Web app secrets & build output (NEVER commit) ────────────
web/.env.local
web/.env*.local
web/node_modules/
web/.next/
web/out/

# ── Xcode build artifacts ───────────────────────────────────
build/
DerivedData/
*.xccheckout
*.xcscmblueprint
main


# ── Xcode user-specific settings ────────────────────────────
*.xcuserstate
xcuserdata/
*.xcuserdata/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/

# ── macOS clutter ───────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon[$'\r']
._*
.Spotlight-V100
.Trashes

# ── Swift Package Manager cache ─────────────────────────────
.build/
.swiftpm/
Packages/
Package.resolved

# ── CocoaPods (if ever used) ────────────────────────────────
Pods/
*.xcworkspace
!default.xcworkspace

# ── Fastlane (if ever used) ─────────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ── Crash logs / test results ───────────────────────────────
*.crash
*.xcresult

# ── Antigravity IDE scratch ─────────────────────────────────
.antigravityignore
.agents/
.vercel
.env*
fixtures/*raw*.html

# ── KSIS pages saved in Safari (real names): only anonymized copies in fixtures/ksis/ are committed ──
Encore:ksis-samples/
